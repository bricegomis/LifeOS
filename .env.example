# Replace these example values with the production values on the VPS.
SUPABASE_URL=https://your-project-ref.supabase.co
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=lifeos;Username=lifeos;Password=replace-with-a-strong-password
FRONTEND_URL=https://lifeos.example.com
# Optional origin when the Vue UI is served from GitHub Pages.
GITHUB_PAGES_URL=
# Set to true to expose the API schema at /openapi/v1.json and Scalar at /scalar/v1.
# Disabled by default in production; set true only when you need these routes.
ENABLE_OPENAPI_UI=false

# Public browser configuration, written to config.js when the web container starts.
# VITE_SUPABASE_URL must point to the same project as SUPABASE_URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-public-anon-key
VITE_LIFEOS_API_URL=https://api.lifeos.example.com
