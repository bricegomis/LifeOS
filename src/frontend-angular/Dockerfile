FROM node:24-alpine AS build
ARG LIFEOS_BUILD_ID=local
ENV LIFEOS_BUILD_ID=${LIFEOS_BUILD_ID}
ARG LIFEOS_BUILD_NUMBER
ARG LIFEOS_RUN_ID
ARG LIFEOS_RUN_ATTEMPT
ARG LIFEOS_BUILD_REPOSITORY
ARG LIFEOS_BUILD_SERVER_URL
ARG LIFEOS_BUILD_WORKFLOW
ENV LIFEOS_BUILD_NUMBER=${LIFEOS_BUILD_NUMBER}
ENV LIFEOS_RUN_ID=${LIFEOS_RUN_ID}
ENV LIFEOS_RUN_ATTEMPT=${LIFEOS_RUN_ATTEMPT}
ENV LIFEOS_BUILD_REPOSITORY=${LIFEOS_BUILD_REPOSITORY}
ENV LIFEOS_BUILD_SERVER_URL=${LIFEOS_BUILD_SERVER_URL}
ENV LIFEOS_BUILD_WORKFLOW=${LIFEOS_BUILD_WORKFLOW}
WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN npm run build

FROM nginx:1.27-alpine AS final
COPY --from=build /src/dist/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 docker-entrypoint.d/ /docker-entrypoint.d/

EXPOSE 80
