{
  "name": "lifeos-frontend-angular",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-config.mjs",
    "dev": "ng serve",
    "prebuild": "node scripts/generate-config.mjs",
    "build": "ng build --configuration production",
    "pretype-check": "node scripts/generate-config.mjs",
    "type-check": "ng build --configuration development --output-path dist/type-check",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test \"src/**/*.spec.ts\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\""
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@supabase/supabase-js": "^2.59.0",
    "primeicons": "^7.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^24.13.2",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.5.0",
    "prettier": "3.8.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
