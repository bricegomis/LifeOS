# Backend environment variables (never commit a real .env file).
#
# PostgreSQL connection string. Either of the following two forms is accepted
# (see LifeOS.Infrastructure/Persistence/PostgresConnectionStringResolver.cs):
#
# 1. Standard .NET configuration convention (preferred locally):
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=lifeos;Username=lifeos;Password=changeme

# 2. Coolify/Heroku-style URL (preferred in production, e.g. self-hosted on Coolify per ADR 0001):
# DATABASE_URL=postgres://lifeos:changeme@localhost:5432/lifeos

# Supabase project used for authentication only (ADR 0002). The backend never talks to the
# Supabase database; it only validates JWTs issued by this project.
Supabase__Url=https://your-project.supabase.co

# Optional: set to "true" to skip the automatic `dbContext.Database.Migrate()` call at startup
# (e.g. when migrations are applied out-of-band in a deployment pipeline).
# SkipDatabaseMigration=false
