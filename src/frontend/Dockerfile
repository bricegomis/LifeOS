FROM node:22-alpine AS build
WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_LIFEOS_API_URL
ARG VITE_LIFEOS_BUILD_ID=local
ARG VITE_LIFEOS_BUILD_NUMBER
ARG VITE_LIFEOS_RUN_ID
ARG VITE_LIFEOS_RUN_ATTEMPT
ARG VITE_LIFEOS_BUILD_REPOSITORY
ARG VITE_LIFEOS_BUILD_SERVER_URL
ARG VITE_LIFEOS_BUILD_WORKFLOW
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}
ENV VITE_LIFEOS_API_URL=${VITE_LIFEOS_API_URL}
ENV VITE_LIFEOS_BUILD_ID=${VITE_LIFEOS_BUILD_ID}
ENV VITE_LIFEOS_BUILD_NUMBER=${VITE_LIFEOS_BUILD_NUMBER}
ENV VITE_LIFEOS_RUN_ID=${VITE_LIFEOS_RUN_ID}
ENV VITE_LIFEOS_RUN_ATTEMPT=${VITE_LIFEOS_RUN_ATTEMPT}
ENV VITE_LIFEOS_BUILD_REPOSITORY=${VITE_LIFEOS_BUILD_REPOSITORY}
ENV VITE_LIFEOS_BUILD_SERVER_URL=${VITE_LIFEOS_BUILD_SERVER_URL}
ENV VITE_LIFEOS_BUILD_WORKFLOW=${VITE_LIFEOS_BUILD_WORKFLOW}

RUN npm run build

FROM nginx:1.27-alpine AS final
COPY --from=build /src/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
